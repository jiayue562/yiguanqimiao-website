# Cloudflare Pages Headers
# 生成时间: 2026-09-07 00:24（2026-11-16 SEO 升级增补）
# Clean URL文件（无扩展名）→ Content-Type: text/html
# 规则：精确目录路径，避免路由异常

# ── 全站安全头 ─────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN

# ── HTML：始终回源校验，保证改动即时生效 ──────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── CSS/JS：回源校验（不再 immutable——测评模块 JS 迭代频繁，
#    一年长缓存会让用户浏览器/CDN 拿旧版脚本，与新 HTML 组合出错）─
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# ── 测评工具页：禁止任何缓存（含个人作答状态，且逻辑迭代频繁）──
/wuxing/quiz*
  Cache-Control: no-store
/wuxing/report*
  Cache-Control: no-store
/wuxing/rel/quiz*
  Cache-Control: no-store
/wuxing/rel/report*
  Cache-Control: no-store

# ── 图片：内容不变即长缓存 ────────────────────────────
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# ── SEO 文本文件 ──────────────────────────────────────
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
